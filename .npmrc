# The nine @deepseek-ai/* peer dependencies are HOST RUNTIME packages: they ship
# inside the DSH installation and must never be resolved from the registry. The
# registry's `latest` for some of them is a stale generation (0.0.1-rc.1), and
# installing it shadows the host runtime — the failure mode that once broke a
# whole DSH install.
#
# Auto peer installation must therefore stay off, in CI as well, so `npm ci`
# reproduces exactly what a local install does.
legacy-peer-deps=true
