{
    "name": "dsh-a2a-bridge",
    "version": "0.1.0",
    "description": "A2A (Agent2Agent) v1.0 bridge for DeepSeek Harness: let DSH instances on a LAN delegate tasks to each other over a visible, first-class session workspace.",
    "private": true,
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./protocol": {
            "types": "./lib/protocol/index.d.ts",
            "default": "./lib/protocol/index.js"
        },
        "./client": "./lib/client.js",
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./locale/*.json": "./locale/*.json",
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "locale",
        "cordis.patch.yml",
        "README.md",
        "LICENSE"
    ],
    "dsh": {
        "manifestVersion": 1,
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-ui-settings",
                "@deepseek-ai/dsh-client-ui-slots",
                "@deepseek-ai/dsh-client-ui-settings-plugins",
                "@deepseek-ai/dsh-client-locale"
            ]
        }
    },
    "engines": {
        "node": ">=22.19.0",
        "dsh": ">=0.2.1-rc.2 <0.3.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "node scripts/typecheck.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify:exports": "node scripts/verify-exports.mjs",
        "verify:version": "node scripts/verify-version.mjs",
        "verify:live": "node scripts/verify-live.mjs",
        "seams": "node scripts/seams.mjs"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.5",
        "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0",
        "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0",
        "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.2 <0.3.0",
        "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
        "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
        "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.2 <0.3.0",
        "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
        "@deepseek-ai/schemastery": "^3.18.5"
    },
    "devDependencies": {
        "@deepseek-ai/schemastery": "^3.18.5",
        "@types/node": "^22.10.0",
        "typescript": "^5.7.2",
        "vitest": "^3.2.4"
    },
    "keywords": [
        "dsh",
        "dsh-plugin",
        "deepseek-harness",
        "a2a",
        "agent2agent",
        "cordis"
    ],
    "license": "MIT"
}
